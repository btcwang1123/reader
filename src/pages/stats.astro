---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { finished } from '../utils/books';

const all = await getCollection('books');
const done = finished(all);

// ---- 總覽數據 ----
const totalFinished = done.length;
const totalPages = done.reduce((s, b) => s + (b.data.progress?.totalPages ?? 0), 0);
const totalMinutes = done.reduce((s, b) => s + (b.data.readingMinutes ?? 0), 0);
const rated = done.filter((b) => b.data.rating);
const avgRating = rated.length
  ? rated.reduce((s, b) => s + (b.data.rating!), 0) / rated.length
  : 0;

// ---- 每年已讀 ----
const years = new Map<number, number>();
for (const b of done) {
  const y = b.data.finishedAt?.getFullYear();
  if (y) years.set(y, (years.get(y) ?? 0) + 1);
}
const perYear = [...years.entries()].sort((a, b) => a[0] - b[0]);

// ---- 評分分布 ----
const dist = [5, 4.5, 4, 3.5, 3, 2.5, 2, 1.5, 1].map((r) => ({
  rating: r,
  count: rated.filter((b) => b.data.rating === r).length
}));

// ---- 熱門作者 ----
const authors = new Map<string, number>();
for (const b of done) authors.set(b.data.author, (authors.get(b.data.author) ?? 0) + 1);
const topAuthors = [...authors.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);

// ---- 熱門標籤 ----
const tagCounts = new Map<string, number>();
for (const b of done) for (const t of b.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const topTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);

const maxCount = Math.max(...perYear.map(([, c]) => c), 1);
const maxDist = Math.max(...dist.map((d) => d.count), 1);

const overview = [
  { label: '累積已讀', value: totalFinished, unit: ' 本' },
  { label: '累積頁數', value: totalPages.toLocaleString(), unit: ' 頁' },
  { label: '平均評分', value: avgRating ? avgRating.toFixed(1) : '—', unit: ' / 5' },
  { label: '閱讀時數', value: (totalMinutes / 60).toFixed(1), unit: ' 小時' }
];
---

<Layout title="統計">
  <h1 class="mb-8 text-2xl font-bold">📊 閱讀統計</h1>

  <section class="grid grid-cols-2 gap-4 md:grid-cols-4">
    {overview.map((s) => (
      <div class="rounded-xl border border-amber-200 bg-white p-4 text-center shadow-sm">
        <div class="text-3xl font-bold text-stone-800">
          {s.value}
        </div>
        <div class="mt-1 text-sm text-stone-500">{s.label}{s.unit}</div>
      </div>
    ))}
  </section>

  <section class="mt-10">
    <h2 class="mb-4 text-xl font-bold text-stone-800">📅 每年已讀本數</h2>
    {perYear.length > 0 ? (
      <div class="flex items-end gap-3 rounded-xl border border-amber-200 bg-white p-5">
        {perYear.map(([year, count]) => (
          <div class="flex flex-1 flex-col items-center gap-1">
            <span class="text-xs text-stone-600">{count}</span>
            <div
              class="w-full rounded-t bg-amber-400"
              style={`height:${Math.max((count / maxCount) * 120, 6)}px`}
              title={`${year}:${count} 本`}
            />
            <span class="text-xs text-stone-500">{year}</span>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-stone-500">還沒有已讀紀錄。</p>
    )}
  </section>

  <section class="mt-10 grid gap-6 md:grid-cols-2">
    <div>
      <h2 class="mb-4 text-xl font-bold text-stone-800">⭐ 評分分布</h2>
      <div class="rounded-xl border border-amber-200 bg-white p-5">
        {dist.map((d) => (
          <div class="mb-2 flex items-center gap-3">
            <span class="w-8 text-sm text-stone-600">{d.rating.toFixed(1)}</span>
            <div class="h-4 flex-1 overflow-hidden rounded bg-stone-100">
              <div
                class="h-full rounded bg-amber-400"
                style={`width:${(d.count / maxDist) * 100}%`}
              />
            </div>
            <span class="w-6 text-right text-sm text-stone-500">{d.count}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="space-y-6">
      <div>
        <h2 class="mb-4 text-xl font-bold text-stone-800">✍️ 讀最多的作者</h2>
        <div class="rounded-xl border border-amber-200 bg-white p-5">
          {topAuthors.length > 0 ? (
            <ul class="space-y-2">
              {topAuthors.map(([name, count]) => (
                <li class="flex justify-between text-sm">
                  <span class="text-stone-700">{name}</span>
                  <span class="text-stone-500">{count} 本</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-stone-500">暫無資料。</p>
          )}
        </div>
      </div>

      <div>
        <h2 class="mb-4 text-xl font-bold text-stone-800">🏷️ 使用最多的標籤</h2>
        <div class="rounded-xl border border-amber-200 bg-white p-5">
          {topTags.length > 0 ? (
            <ul class="space-y-2">
              {topTags.map(([tag, count]) => (
                <li class="flex justify-between text-sm">
                  <span class="text-amber-800">#{tag}</span>
                  <span class="text-stone-500">{count} 本</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-stone-500">暫無資料。</p>
          )}
        </div>
      </div>
    </div>
  </section>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { resolveList } from '../../utils/lists';

const lists = await Promise.all(
  (await getCollection('lists'))
    .sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-Hant'))
    .map(async (list) => ({ list, ...(await resolveList(list)) }))
);
const BASE = import.meta.env.BASE_URL;
---

<Layout title="書單" description="依主題或系列整理的書單。">
  <header class="mb-10">
    <p class="eyebrow">Curated shelves</p>
    <h1 class="page-title mt-3">書單與系列</h1>
    <p class="mt-4 max-w-xl text-sm leading-7 text-stone-500">把相關的書排在一起，照著順序讀，或推薦給剛好需要的人。</p>
  </header>

  {lists.length > 0 ? (
    <div class="grid gap-5 md:grid-cols-2">
      {lists.map(({ list, books }) => {
        const finishedCount = books.filter((book) => book.data.status === 'finished').length;
        return (
          <a href={`${BASE}lists/${list.id}/`} class="surface card-lift group rounded-[1.4rem] p-6">
            <h2 class="font-serif text-2xl font-semibold text-stone-900 transition group-hover:text-clay">{list.data.title}</h2>
            {list.data.description && <p class="mt-2 text-sm leading-6 text-stone-500">{list.data.description}</p>}
            <p class="mt-4 text-xs text-stone-400">{books.length} 本 · 已讀 {finishedCount} 本</p>
            <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-stone-100">
              <div class="h-full rounded-full bg-sage" style={`width:${books.length ? (finishedCount / books.length) * 100 : 0}%`}></div>
            </div>
          </a>
        );
      })}
    </div>
  ) : (
    <div class="surface rounded-[1.6rem] px-6 py-16 text-center">
      <h2 class="font-serif text-xl font-semibold text-stone-800">還沒有書單</h2>
      <p class="mt-2 text-sm text-stone-500">在 <code class="rounded bg-stone-100 px-1.5 py-0.5">src/content/lists/</code> 新增一個 Markdown 檔即可建立書單。</p>
    </div>
  )}
</Layout>

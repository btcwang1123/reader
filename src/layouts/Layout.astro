---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 分享圖(絕對或相對路徑,會被接上 base) */
  image?: string;
  /** 是否納入站內全文搜尋(Pagefind);書籍詳情頁才需要 */
  searchable?: boolean;
}

const {
  title = '',
  description = '收藏讀過的書、沿途的想法，以及那些捨不得忘記的句子。',
  image,
  searchable = false
} = Astro.props;

const SITE_TITLE = '拾頁書室';
const SITE_ORIGIN = new URL(import.meta.env.SITE ?? 'https://example.com').origin;
const BASE = import.meta.env.BASE_URL;
const DEFAULT_SHARE_IMAGE = new URL(`${BASE}share-cover.jpg`, `${SITE_ORIGIN}/`).href;
// 相對圖片路徑以網站 base 為根,絕對網址可直接傳入
const SHARE_IMAGE = !image
  ? DEFAULT_SHARE_IMAGE
  : image.startsWith('http')
    ? image
    : new URL(`${BASE}${image.replace(/^\/+/, '')}`, `${SITE_ORIGIN}/`).href;
// Astro.url.pathname 在 GitHub Pages 已包含 base,所以只接 site origin 避免重複 repo 路徑
const pageUrl = new URL(Astro.url.pathname, `${SITE_ORIGIN}/`).href;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const nav = [
  { href: `${BASE}`, label: '首頁' },
  { href: `${BASE}books/`, label: '書庫' },
  { href: `${BASE}quotes/`, label: '書摘' },
  { href: `${BASE}lists/`, label: '書單' },
  { href: `${BASE}stats/`, label: '閱讀足跡' },
  { href: `${BASE}timeline/`, label: '編年史' },
  { href: `${BASE}calendar/`, label: '閱讀日曆' },
  { href: `${BASE}about/`, label: '關於' }
];
const pathname = Astro.url.pathname;
const isActive = (href: string) => href === BASE ? pathname === BASE : pathname.startsWith(href);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f3eb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171412" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // 在繪製前決定深淺色,避免先閃一下白色。reader-theme: light / dark / 未設定 = 跟隨系統
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('reader-theme');
          // 舊版「夜讀」設定搬過來
          if (!saved && localStorage.getItem('reader-night') === 'on') {
            saved = 'dark';
            localStorage.setItem('reader-theme', 'dark');
          }
          localStorage.removeItem('reader-night');
        } catch (e) {}
        var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.setAttribute('data-theme', 'dark');
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <link rel="manifest" href={`${BASE}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${BASE}icon-192.png`} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS`} href={`${BASE}rss.xml`} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <!-- 社群分享 (Open Graph / Twitter Card) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={SHARE_IMAGE} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SHARE_IMAGE} />
    {
      import.meta.env.PROD && (
        <script
          is:inline
          data-goatcounter="https://btcwang.goatcounter.com/count"
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <a href="#main-content" class="fixed left-4 top-4 z-[60] -translate-y-24 rounded-full bg-stone-900 px-4 py-2 text-sm text-white transition focus:translate-y-0">
      跳至主要內容
    </a>

    <header class="site-header sticky top-0 z-50 border-b border-stone-200/70 bg-paper/88 backdrop-blur-xl">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3.5 sm:px-8">
        <a href={BASE} class="group flex shrink-0 items-center gap-3" aria-label={`${SITE_TITLE}首頁`}>
          <span class="grid size-10 place-items-center rounded-xl bg-stone-900 text-white shadow-sm transition duration-300 group-hover:-rotate-3 group-hover:bg-clay" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.5 5.5A2.5 2.5 0 0 1 7 3h5v16H7a2.5 2.5 0 0 0-2.5 2z" />
              <path d="M19.5 5.5A2.5 2.5 0 0 0 17 3h-5v16h5a2.5 2.5 0 0 1 2.5 2z" />
            </svg>
          </span>
          <span>
            <span class="block font-serif text-lg font-bold leading-none tracking-wide text-stone-900">拾頁書室</span>
            <span class="mt-1 hidden text-[0.6rem] font-semibold uppercase tracking-[0.19em] text-stone-400 sm:block">Reading journal</span>
          </span>
        </a>

        <nav class="no-scrollbar -mr-2 flex items-center gap-1 overflow-x-auto px-2 text-sm" aria-label="主要導覽">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'relative shrink-0 rounded-full px-3.5 py-2 font-medium transition sm:px-4',
                isActive(item.href) ? 'bg-stone-900 text-white shadow-sm' : 'text-stone-600 hover:bg-white/80 hover:text-clay'
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <button
            type="button"
            data-theme-toggle
            class="-ml-2 grid size-9 shrink-0 place-items-center rounded-full text-stone-600 transition hover:bg-white/80 hover:text-clay"
            aria-label="切換深淺色"
            title="切換深淺色(跟隨系統 → 淺色 → 深色)"
          >
            <span data-theme-icon="system"><svg viewBox="0 0 24 24" class="size-[1.1rem]" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 3.5v17A8.5 8.5 0 0 0 12 3.5Z" fill="currentColor" /></svg></span>
            <span data-theme-icon="light" hidden><svg viewBox="0 0 24 24" class="size-[1.1rem]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg></span>
            <span data-theme-icon="dark" hidden><svg viewBox="0 0 24 24" class="size-[1.1rem]" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" /></svg></span>
        </button>
      </div>
    </header>

    <main id="main-content" class="mx-auto min-h-[70vh] w-full max-w-6xl px-5 py-9 sm:px-8 sm:py-14" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>

    <footer class="site-footer mt-12 border-t border-stone-200/80 bg-white/35">
      <div class="mx-auto flex max-w-6xl flex-col gap-5 px-5 py-9 text-sm text-stone-500 sm:flex-row sm:items-end sm:justify-between sm:px-8">
        <div>
          <p class="font-serif text-xl font-bold text-stone-800">拾頁書室</p>
          <p class="mt-1.5">把讀過的日子，收進一頁一頁的文字裡。</p>
        </div>
        <div class="flex flex-col items-start gap-4 sm:items-end">
          <div class="flex items-center gap-4">
            <a href={`${BASE}export/`} class="transition hover:text-clay">資料匯出</a>
            <a href={`${BASE}rss.xml`} class="transition hover:text-clay">RSS 訂閱</a>
            <span class="text-stone-300" aria-hidden="true">·</span>
            <span>Astro + Markdown</span>
          </div>
          {
            import.meta.env.PROD && (
              <span data-visit-count class="inline-flex items-center gap-1.5 rounded-full bg-stone-100 px-3 py-1 text-xs text-stone-400">
                <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="2.5" /></svg>
                <span data-visit-count-num>–</span> 人次瀏覽
              </span>
            )
          }
        </div>
      </div>
    </footer>

    <script>
      // 深淺色切換:跟隨系統 → 淺色 → 深色 循環
      type Theme = 'system' | 'light' | 'dark';
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const media = window.matchMedia('(prefers-color-scheme: dark)');
      const labels: Record<Theme, string> = { system: '跟隨系統', light: '淺色', dark: '深色' };

      function readTheme(): Theme {
        try {
          const saved = localStorage.getItem('reader-theme');
          if (saved === 'light' || saved === 'dark') return saved;
        } catch {}
        return 'system';
      }

      function applyTheme(theme: Theme) {
        const dark = theme === 'dark' || (theme === 'system' && media.matches);
        if (dark) root.setAttribute('data-theme', 'dark');
        else root.removeAttribute('data-theme');
        toggle?.querySelectorAll<HTMLElement>('[data-theme-icon]').forEach((icon) => {
          icon.hidden = icon.dataset.themeIcon !== theme;
        });
        toggle?.setAttribute('aria-label', `深淺色:${labels[theme]}(點擊切換)`);
        // 通知其他元件(例如 Giscus 留言區)跟著換色
        window.dispatchEvent(new CustomEvent('reader-theme', { detail: { dark } }));
      }

      toggle?.addEventListener('click', () => {
        const order: Theme[] = ['system', 'light', 'dark'];
        const next = order[(order.indexOf(readTheme()) + 1) % order.length];
        try {
          if (next === 'system') localStorage.removeItem('reader-theme');
          else localStorage.setItem('reader-theme', next);
        } catch {}
        applyTheme(next);
      });
      media.addEventListener('change', () => { if (readTheme() === 'system') applyTheme('system'); });
      applyTheme(readTheme());

      // PWA:註冊 service worker(僅正式站,開發時不快取)
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        navigator.serviceWorker.register(`${import.meta.env.BASE_URL}sw.js`).catch(() => {});
      }
    </script>

    {
      import.meta.env.PROD && (
        <script is:inline>
          fetch('https://btcwang.goatcounter.com/counter/TOTAL.json')
            .then(function (r) { return r.json(); })
            .then(function (d) {
              var el = document.querySelector('[data-visit-count-num]');
              if (el && d && d.count) el.textContent = d.count;
            })
            .catch(function () {});
        </script>
      )
    }
  </body>
</html>

---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '',
  description = '收藏讀過的書、沿途的想法，以及那些捨不得忘記的句子。'
} = Astro.props;

const SITE_TITLE = '拾頁書室';
const BASE = import.meta.env.BASE_URL;
const nav = [
  { href: `${BASE}`, label: '首頁' },
  { href: `${BASE}books/`, label: '書庫' },
  { href: `${BASE}stats/`, label: '閱讀足跡' },
  { href: `${BASE}about/`, label: '關於' }
];
const pathname = Astro.url.pathname;
const isActive = (href: string) => href === BASE ? pathname === BASE : pathname.startsWith(href);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f3eb" />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS`} href={`${BASE}rss.xml`} />
    <title>{title ? `${title} · ${SITE_TITLE}` : SITE_TITLE}</title>
    <meta name="description" content={description} />
    {
      import.meta.env.PROD && (
        <script
          is:inline
          data-goatcounter="https://btcwang.goatcounter.com/count"
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <a href="#main-content" class="fixed left-4 top-4 z-[60] -translate-y-24 rounded-full bg-stone-900 px-4 py-2 text-sm text-white transition focus:translate-y-0">
      跳至主要內容
    </a>

    <header class="sticky top-0 z-50 border-b border-stone-200/70 bg-paper/88 backdrop-blur-xl">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3.5 sm:px-8">
        <a href={BASE} class="group flex shrink-0 items-center gap-3" aria-label={`${SITE_TITLE}首頁`}>
          <span class="grid size-10 place-items-center rounded-xl bg-stone-900 text-white shadow-sm transition duration-300 group-hover:-rotate-3 group-hover:bg-clay" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.5 5.5A2.5 2.5 0 0 1 7 3h5v16H7a2.5 2.5 0 0 0-2.5 2z" />
              <path d="M19.5 5.5A2.5 2.5 0 0 0 17 3h-5v16h5a2.5 2.5 0 0 1 2.5 2z" />
            </svg>
          </span>
          <span>
            <span class="block font-serif text-lg font-bold leading-none tracking-wide text-stone-900">拾頁書室</span>
            <span class="mt-1 hidden text-[0.6rem] font-semibold uppercase tracking-[0.19em] text-stone-400 sm:block">Reading journal</span>
          </span>
        </a>

        <nav class="no-scrollbar -mr-2 flex items-center gap-1 overflow-x-auto px-2 text-sm" aria-label="主要導覽">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'relative shrink-0 rounded-full px-3.5 py-2 font-medium transition sm:px-4',
                isActive(item.href) ? 'bg-stone-900 text-white shadow-sm' : 'text-stone-600 hover:bg-white/80 hover:text-clay'
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main-content" class="mx-auto min-h-[70vh] w-full max-w-6xl px-5 py-9 sm:px-8 sm:py-14">
      <slot />
    </main>

    <footer class="mt-12 border-t border-stone-200/80 bg-white/35">
      <div class="mx-auto flex max-w-6xl flex-col gap-5 px-5 py-9 text-sm text-stone-500 sm:flex-row sm:items-end sm:justify-between sm:px-8">
        <div>
          <p class="font-serif text-xl font-bold text-stone-800">拾頁書室</p>
          <p class="mt-1.5">把讀過的日子，收進一頁一頁的文字裡。</p>
        </div>
        <div class="flex items-center gap-4">
          <a href={`${BASE}export/`} class="transition hover:text-clay">資料匯出</a>
          <a href={`${BASE}rss.xml`} class="transition hover:text-clay">RSS 訂閱</a>
          <span class="text-stone-300" aria-hidden="true">·</span>
          <span>Astro + Markdown</span>
        </div>
      </div>
    </footer>
  </body>
</html>

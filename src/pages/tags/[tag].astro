---
import Layout from '../../layouts/Layout.astro';
import BookCard from '../../components/BookCard.astro';
import { getCollection } from 'astro:content';
import { sortByStartedDesc } from '../../utils/books';

export async function getStaticPaths() {
  const all = await getCollection('books');
  const tags = [...new Set(all.flatMap((b) => b.data.tags))].sort((a, b) =>
    a.localeCompare(b, 'zh-Hant')
  );
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.props;
const all = sortByStartedDesc(await getCollection('books'));
const books = all.filter((b) => b.data.tags.includes(tag));
const BASE = import.meta.env.BASE_URL;
---

<Layout title={`#${tag}`}>
  <nav class="mb-6 text-sm text-stone-400">
    <a href={`${BASE}books/`} class="transition hover:text-amber-700">書庫</a>
    <span class="mx-2 text-stone-300">/</span>
    <span class="text-stone-600">#{tag}</span>
  </nav>

  <div class="mb-8 flex items-center gap-3">
    <h1 class="font-serif text-3xl font-medium text-stone-800">#{tag}</h1>
    <span class="flex-1 border-t border-stone-200" aria-hidden="true"></span>
    <span class="text-sm text-stone-400">共 {books.length} 本</span>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    {books.map((b) => (
      <BookCard book={b} />
    ))}
  </div>
</Layout>

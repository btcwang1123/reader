---
import Layout from '../../layouts/Layout.astro';
import BookCard from '../../components/BookCard.astro';
import { getCollection } from 'astro:content';
import { resolveList, type BookList } from '../../utils/lists';

export async function getStaticPaths() {
  const lists = await getCollection('lists');
  return lists.map((list) => ({ params: { slug: list.id }, props: { list } }));
}

const { list } = Astro.props as { list: BookList };
const { books, missing } = await resolveList(list);
const finishedCount = books.filter((book) => book.data.status === 'finished').length;
const BASE = import.meta.env.BASE_URL;
---

<Layout title={list.data.title} description={list.data.description ?? `書單：${list.data.title}`}>
  <nav class="mb-8 flex items-center gap-2 text-sm text-stone-400" aria-label="麵包屑">
    <a href={`${BASE}lists/`} class="transition hover:text-clay">書單</a><span aria-hidden="true">/</span><span class="text-stone-600">{list.data.title}</span>
  </nav>

  <header class="mb-9 border-b border-stone-200 pb-8">
    <p class="eyebrow">Reading list</p>
    <h1 class="page-title mt-3">{list.data.title}</h1>
    {list.data.description && <p class="mt-4 max-w-2xl text-sm leading-7 text-stone-500">{list.data.description}</p>}
    <p class="mt-4 text-sm text-stone-500">共 <strong class="text-stone-800">{books.length}</strong> 本，已讀 <strong class="text-stone-800">{finishedCount}</strong> 本</p>
  </header>

  <ol class="grid gap-5 md:grid-cols-2">
    {books.map((book, index) => (
      <li class="relative">
        <span class="absolute -left-2 -top-2 z-20 grid size-7 place-items-center rounded-full bg-stone-900 text-xs font-bold text-white shadow">{index + 1}</span>
        <BookCard book={book} />
      </li>
    ))}
  </ol>

  {import.meta.env.DEV && missing.length > 0 && (
    <p class="mt-6 rounded-xl bg-orange-50 px-4 py-3 text-sm text-stone-600">找不到這些書(請確認檔名或書名):{missing.join('、')}</p>
  )}
</Layout>

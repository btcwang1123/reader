---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { finished } from '../utils/books';

const all = await getCollection('books');
const done = finished(all);

const totalFinished = done.length;
const totalPages = done.reduce((s, b) => s + (b.data.progress?.totalPages ?? 0), 0);
const totalMinutes = done.reduce((s, b) => s + (b.data.readingMinutes ?? 0), 0);
const rated = done.filter((b) => b.data.rating);
const avgRating = rated.length
  ? rated.reduce((s, b) => s + (b.data.rating!), 0) / rated.length
  : 0;

const years = new Map<number, number>();
for (const b of done) {
  const y = b.data.finishedAt?.getFullYear();
  if (y) years.set(y, (years.get(y) ?? 0) + 1);
}
const perYear = [...years.entries()].sort((a, b) => a[0] - b[0]);

const dist = [5, 4.5, 4, 3.5, 3, 2.5, 2, 1.5, 1].map((r) => ({
  rating: r,
  count: rated.filter((b) => b.data.rating === r).length
}));

const authors = new Map<string, number>();
for (const b of done) authors.set(b.data.author, (authors.get(b.data.author) ?? 0) + 1);
const topAuthors = [...authors.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);

const tagCounts = new Map<string, number>();
for (const b of done) for (const t of b.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const topTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);

const maxCount = Math.max(...perYear.map(([, c]) => c), 1);
const maxDist = Math.max(...dist.map((d) => d.count), 1);

const overview = [
  { label: '累積已讀', value: String(totalFinished), unit: '本' },
  { label: '累積頁數', value: totalPages.toLocaleString(), unit: '頁' },
  { label: '平均評分', value: avgRating ? avgRating.toFixed(1) : '—', unit: '/5' },
  { label: '閱讀時數', value: (totalMinutes / 60).toFixed(1), unit: 'hr' }
];
---

<Layout title="統計">
  <div class="mb-8 flex items-center gap-3">
    <h1 class="font-serif text-3xl font-medium text-stone-800">閱讀統計</h1>
    <span class="flex-1 border-t border-stone-200" aria-hidden="true"></span>
  </div>

  <section class="mb-12 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
    {overview.map((s) => (
      <div class="rounded-2xl border border-stone-200/80 bg-white/70 px-4 py-6 text-center shadow-sm">
        <div class="font-serif text-3xl font-semibold text-stone-800">{s.value}</div>
        <div class="mt-1 text-sm text-stone-500">{s.label}</div>
        <div class="mt-1 text-xs text-stone-400">{s.unit}</div>
      </div>
    ))}
  </section>

  <section class="mb-12">
    <div class="mb-4 flex items-center gap-3">
      <h2 class="font-serif text-xl font-medium text-stone-800">每年已讀本數</h2>
      <span class="flex-1 border-t border-stone-200" aria-hidden="true"></span>
    </div>
    {perYear.length > 0 ? (
      <div class="flex items-end gap-4 rounded-2xl border border-stone-200/80 bg-white p-6 shadow-sm">
        {perYear.map(([year, count]) => (
          <div class="flex flex-1 flex-col items-center gap-2">
            <span class="text-xs text-stone-500">{count}</span>
            <div
              class="w-full rounded-t-lg bg-gradient-to-t from-amber-500 to-amber-300 transition-all hover:to-amber-400"
              style={`height:${Math.max((count / maxCount) * 120, 8)}px`}
              title={`${year}:共 ${count} 本`}
            />
            <span class="text-xs text-stone-500">{year}</span>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-stone-500">還沒有已讀紀錄。</p>
    )}
  </section>

  <section class="grid gap-8 md:grid-cols-2">
    <div>
      <div class="mb-4 flex items-center gap-3">
        <h2 class="font-serif text-xl font-medium text-stone-800">評分分布</h2>
        <span class="flex-1 border-t border-stone-200" aria-hidden="true"></span>
      </div>
      <div class="rounded-2xl border border-stone-200/80 bg-white p-6 shadow-sm">
        {dist.map((d) => (
          <div class="mb-2.5 flex items-center gap-3">
            <span class="w-8 text-sm text-stone-500">{d.rating.toFixed(1)}</span>
            <div class="h-3 flex-1 overflow-hidden rounded-full bg-stone-100">
              <div
                class="h-full rounded-full bg-gradient-to-r from-amber-500 to-amber-300"
                style={`width:${(d.count / maxDist) * 100}%`}
              />
            </div>
            <span class="w-5 text-right text-xs text-stone-400">{d.count}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="space-y-8">
      <div>
        <div class="mb-4 flex items-center gap-3">
          <h2 class="font-serif text-xl font-medium text-stone-800">讀最多的作者</h2>
          <span class="flex-1 border-t border-stone-200" aria-hidden="true"></span>
        </div>
        <div class="rounded-2xl border border-stone-200/80 bg-white p-6 shadow-sm">
          {topAuthors.length > 0 ? (
            <ul class="space-y-3">
              {topAuthors.map(([name, count]) => (
                <li class="flex items-center justify-between">
                  <span class="text-stone-700">{name}</span>
                  <span class="rounded-full bg-amber-100/80 px-2.5 py-0.5 text-xs text-amber-800">{count} 本</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-stone-500">暫無資料。</p>
          )}
        </div>
      </div>

      <div>
        <div class="mb-4 flex items-center gap-3">
          <h2 class="font-serif text-xl font-medium text-stone-800">使用最多的標籤</h2>
          <span class="flex-1 border-t border-stone-200" aria-hidden="true"></span>
        </div>
        <div class="rounded-2xl border border-stone-200/80 bg-white p-6 shadow-sm">
          {topTags.length > 0 ? (
            <ul class="space-y-3">
              {topTags.map(([tag, count]) => (
                <li class="flex items-center justify-between">
                  <span class="font-serif text-stone-700">#{tag}</span>
                  <span class="rounded-full bg-stone-100 px-2.5 py-0.5 text-xs text-stone-500">{count} 本</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-stone-500">暫無資料。</p>
          )}
        </div>
      </div>
    </div>
  </section>
</Layout>

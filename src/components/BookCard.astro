---
import type { Book } from '../utils/books';
import { STATUS_LABELS } from '../utils/books';
import Stars from './Stars.astro';

interface Props {
  book: Book;
}
const { book } = Astro.props;
const { title, author, cover, status, rating, tags, finishedAt } = book.data;
const BASE = import.meta.env.BASE_URL;
const href = `${BASE}books/${book.id}/`;
---

<a
  href={href}
  class="group flex gap-4 rounded-xl border border-amber-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
>
  {cover && (
    <img
      src={cover.startsWith('/') ? BASE + cover.slice(1) : cover}
      alt={`${title} 封面`}
      class="h-36 w-24 flex-shrink-0 rounded-md bg-amber-100 object-cover"
    />
  )}
  <div class="min-w-0">
    <h3 class="font-serif text-lg font-bold leading-snug text-stone-800 group-hover:text-amber-700">
      {title}
    </h3>
    <p class="mt-1 text-sm text-stone-500">{author}</p>
    <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
      <span
        class:list={[
          'rounded-full px-2 py-0.5',
          status === 'finished' && 'bg-emerald-100 text-emerald-700',
          status === 'reading' && 'bg-sky-100 text-sky-700',
          status === 'wantToRead' && 'bg-stone-200 text-stone-600'
        ]}
      >
        {STATUS_LABELS[status]}
      </span>
      {rating && <Stars rating={rating} />}
      {tags.slice(0, 3).map((t) => (
        <span class="rounded bg-amber-100 px-1.5 py-0.5 text-amber-700">{t}</span>
      ))}
    </div>
    {finishedAt && (
      <p class="mt-2 text-xs text-stone-400">讀完於 {finishedAt.toISOString().slice(0, 10)}</p>
    )}
  </div>
</a>

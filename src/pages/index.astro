---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import { getCollection } from 'astro:content';
import { sortByStartedDesc } from '../utils/books';

const all = sortByStartedDesc(await getCollection('books'));
const finishedBooks = all.filter((b) => b.data.status === 'finished');
const readingBooks = all.filter((b) => b.data.status === 'reading');

const currentYear = new Date().getFullYear();
const finishedThisYear = finishedBooks.filter(
  (b) => b.data.finishedAt?.getFullYear() === currentYear
);
const totalPages = finishedBooks.reduce(
  (sum, b) => sum + (b.data.progress?.totalPages ?? 0),
  0
);
const avgRating = finishedBooks.length
  ? finishedBooks.reduce((s, b) => s + (b.data.rating ?? 0), 0) / finishedBooks.length
  : 0;

const statCards = [
  { label: '累積已讀', value: String(finishedBooks.length), unit: '本' },
  { label: `${currentYear} 年已讀`, value: String(finishedThisYear.length), unit: '本' },
  { label: '平均評分', value: avgRating ? avgRating.toFixed(1) : '—', unit: '/ 5' },
  { label: '累積頁數', value: totalPages ? totalPages.toLocaleString() : '—', unit: '頁' }
];
---

<Layout>
  <!-- 書卷風首頁引言 -->
  <section class="mb-10 text-center">
    <p class="mx-auto mb-3 h-px w-24 bg-amber-300" aria-hidden="true"></p>
    <h1 class="font-serif text-3xl font-medium tracking-wide text-stone-800 sm:text-4xl">
      一方安放讀過的書的角落
    </h1>
    <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-stone-500">
      我讀過的書、寫下的心得,與捨不得忘了的句子。
    </p>
    <p class="mx-auto mt-6 h-px w-24 bg-amber-300" aria-hidden="true"></p>
  </section>

  <!-- 統計亮點 -->
  <section class="mb-12 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
    {statCards.map((s) => (
      <div class="rounded-2xl border border-stone-200/80 bg-white/70 px-4 py-5 text-center shadow-sm backdrop-blur">
        <div class="font-serif text-3xl font-semibold text-stone-800">
          {s.value}
          <span class="ml-1 text-sm font-normal text-stone-400">{s.unit}</span>
        </div>
        <div class="mt-1 text-xs tracking-wide text-stone-500">{s.label}</div>
      </div>
    ))}
  </section>

  {readingBooks.length > 0 && (
    <section class="mb-12">
      <div class="mb-4 flex items-center gap-3">
        <h2 class="font-serif text-xl font-medium text-stone-800">正在讀</h2>
        <span class="flex-1 border-t border-stone-200" aria-hidden="true"></span>
      </div>
      <div class="grid gap-4">
        {readingBooks.map((b) => (
          <BookCard book={b} />
        ))}
      </div>
    </section>
  )}

  {finishedBooks.length > 0 && (
    <section class="mb-12">
      <div class="mb-4 flex items-center gap-3">
        <h2 class="font-serif text-xl font-medium text-stone-800">最近讀完</h2>
        <span class="flex-1 border-t border-stone-200" aria-hidden="true"></span>
      </div>
      <div class="grid gap-4">
        {finishedBooks.slice(0, 5).map((b) => (
          <BookCard book={b} />
        ))}
      </div>
    </section>
  )}
</Layout>

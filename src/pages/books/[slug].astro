---
import Layout from '../../layouts/Layout.astro';
import Stars from '../../components/Stars.astro';
import { getCollection, render } from 'astro:content';
import { STATUS_LABELS } from '../../utils/books';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({
    params: { slug: book.id },
    props: { book }
  }));
}

const { book } = Astro.props;
const { Content } = await render(book);
const {
  title,
  author,
  cover,
  status,
  rating,
  tags,
  isbn,
  publisher,
  publishedYear,
  startedAt,
  finishedAt,
  progress
} = book.data;
const BASE = import.meta.env.BASE_URL;
const statusBadgeStyle = {
  finished: 'bg-emerald-600/10 text-emerald-700 ring-emerald-600/20',
  reading: 'bg-sky-600/10 text-sky-700 ring-sky-600/20',
  wantToRead: 'bg-stone-100 text-stone-500 ring-stone-200'
}[status];
const metaRows = [
  publisher && ['出版社', publisher],
  publishedYear && ['出版年', String(publishedYear)],
  isbn && ['ISBN', isbn],
  startedAt && ['開始閱讀', startedAt.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })],
  finishedAt && ['讀完日期', finishedAt.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })],
  progress && ['閱讀進度', `${progress.currentPage} / ${progress.totalPages} 頁`]
].filter(Boolean) as [string, string][];
---

<Layout title={title} description={`${title} — ${author}`}>
  <nav class="mb-8 text-sm text-stone-400">
    <a href={`${BASE}books/`} class="transition hover:text-amber-700">書庫</a>
    <span class="mx-2 text-stone-300">/</span>
    <span class="text-stone-600">{title}</span>
  </nav>

  <!-- 書本主視覺 -->
  <section class="mb-12 flex flex-col gap-8 sm:flex-row">
    <div class="flex flex-col items-center sm:items-start">
      {cover ? (
        <img
          src={cover.startsWith('/') ? BASE + cover.slice(1) : cover}
          alt={`${title} 封面`}
          class="h-64 w-44 flex-shrink-0 rounded-r-xl rounded-l-md bg-amber-100 object-cover shadow-xl shadow-amber-900/10"
        />
      ) : (
        <div class="relative flex h-64 w-44 flex-shrink-0 flex-col justify-end overflow-hidden rounded-r-xl rounded-l-md bg-gradient-to-br from-stone-700 via-stone-800 to-stone-900 p-4 shadow-xl shadow-amber-900/10">
          <div class="absolute inset-y-0 left-0 w-1.5 bg-amber-500/90" aria-hidden="true" />
          <span class="font-serif text-base font-medium leading-snug text-stone-100">{title}</span>
          <span class="mt-1 text-xs text-stone-400">{author}</span>
        </div>
      )}
    </div>

    <div class="min-w-0 flex-1">
      <span class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ring-1 ${statusBadgeStyle}`}>
        {STATUS_LABELS[status]}
      </span>
      <h1 class="mt-3 font-serif text-3xl font-semibold leading-tight text-stone-800">{title}</h1>
      <p class="mt-2 text-base text-stone-500">作者：{author}</p>

      {rating && (
        <div class="mt-4 flex items-center gap-2">
          <Stars rating={rating} />
          <span class="text-sm text-stone-400">{rating.toFixed(1)} / 5</span>
        </div>
      )}

      <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-2.5 text-sm sm:grid-cols-3">
        {metaRows.map(([k, v]) => (
          <div>
            <dt class="text-xs text-stone-400">{k}</dt>
            <dd class="mt-0.5 text-stone-700">{v}</dd>
          </div>
        ))}
      </dl>

      {tags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {tags.map((t) => (
            <a
              href={`${BASE}tags/${t}/`}
              class="rounded-full bg-stone-100 px-3 py-1 text-xs text-stone-500 transition hover:bg-amber-100 hover:text-amber-800"
            >
              #{t}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- 心得本體 -->
  <article class="rounded-2xl border border-stone-200/80 bg-white p-6 shadow-sm sm:p-10">
    <div class="prose prose-stone prose-lg max-w-none">
      <Content />
    </div>
  </article>
</Layout>

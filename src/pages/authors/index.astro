---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { authorSlug } from '../../utils/books';

const books = await getCollection('books');
const authors = new Map<string, { total: number; finished: number }>();
for (const book of books) {
  const entry = authors.get(book.data.author) ?? { total: 0, finished: 0 };
  entry.total += 1;
  if (book.data.status === 'finished') entry.finished += 1;
  authors.set(book.data.author, entry);
}
const sorted = [...authors.entries()].sort((a, b) => b[1].total - a[1].total || a[0].localeCompare(b[0], 'zh-Hant'));
const BASE = import.meta.env.BASE_URL;
---

<Layout title="作者" description="依作者瀏覽書架上的書。">
  <header class="mb-10">
    <p class="eyebrow">By author</p>
    <h1 class="page-title mt-3">作者</h1>
    <p class="mt-4 text-sm text-stone-500">書架上共有 <strong class="text-stone-800">{sorted.length}</strong> 位作者</p>
  </header>

  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {sorted.map(([author, count]) => (
      <li>
        <a href={`${BASE}authors/${encodeURIComponent(authorSlug(author))}/`} class="surface card-lift group flex items-center justify-between gap-3 rounded-xl px-5 py-4">
          <span class="truncate font-serif text-lg font-semibold text-stone-900 transition group-hover:text-clay">{author}</span>
          <span class="shrink-0 text-xs text-stone-400">{count.total} 本{count.finished !== count.total && ` · 已讀 ${count.finished}`}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>

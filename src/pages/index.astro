---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import { getCollection } from 'astro:content';
import { sortByStartedDesc } from '../utils/books';

const all = sortByStartedDesc(await getCollection('books'));
const finishedBooks = all.filter((book) => book.data.status === 'finished');
const readingBooks = all.filter((book) => book.data.status === 'reading');
const wantToReadBooks = all.filter((book) => book.data.status === 'wantToRead');
const currentYear = new Date().getFullYear();
const finishedThisYear = finishedBooks.filter(
  (book) => book.data.finishedAt?.getFullYear() === currentYear
);
const totalMinutes = finishedBooks.reduce((sum, book) => sum + (book.data.readingMinutes ?? 0), 0);
const BASE = import.meta.env.BASE_URL;

const tagCounts = new Map<string, number>();
for (const book of all) {
  for (const tag of book.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const popularTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 5);

const statCards = [
  { label: '書架收藏', value: String(all.length).padStart(2, '0'), unit: '本' },
  { label: '正在閱讀', value: String(readingBooks.length).padStart(2, '0'), unit: '本' },
  { label: `${currentYear} 讀完`, value: String(finishedThisYear.length).padStart(2, '0'), unit: '本' },
  { label: '閱讀時光', value: totalMinutes ? (totalMinutes / 60).toFixed(0) : '0', unit: '小時' }
];

const pickOptions = wantToReadBooks.map((book) => ({
  title: book.data.title,
  author: book.data.author,
  tags: book.data.tags.join('・') || '待讀清單',
  href: `${BASE}books/${book.id}/`
}));
const firstPick = pickOptions[0];
---

<Layout>
  <section class="relative mb-16 overflow-hidden rounded-[2rem] bg-stone-900 px-6 py-10 text-white shadow-2xl shadow-stone-900/10 sm:px-10 sm:py-14 lg:px-14">
    <div class="absolute inset-0 opacity-40" aria-hidden="true" style="background-image:radial-gradient(circle at 80% 15%,rgba(238,166,109,.38),transparent 28%),linear-gradient(115deg,transparent 50%,rgba(255,255,255,.04) 50%)"></div>
    <div class="absolute -bottom-16 -right-10 size-56 rounded-full border border-white/10" aria-hidden="true"></div>
    <div class="absolute -bottom-8 right-3 size-40 rounded-full border border-white/10" aria-hidden="true"></div>

    <div class="relative grid items-end gap-10 lg:grid-cols-[1.35fr_0.9fr]">
      <div class="rise-in">
        <p class="text-[0.68rem] font-bold uppercase tracking-[0.24em] text-orange-300">A personal reading journal</p>
        <h1 class="mt-5 max-w-2xl font-serif text-4xl font-semibold leading-[1.22] tracking-[-0.035em] text-stone-50 sm:text-6xl">
          有些書讀完了，<br class="hidden sm:block" />仍在生活裡翻頁。
        </h1>
        <p class="mt-6 max-w-xl text-sm leading-7 text-stone-300 sm:text-base">
          收藏讀過的書、沿途的想法，以及那些捨不得忘記的句子。這裡不是清單，是一段段閱讀生活的切片。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${BASE}books/`} class="inline-flex items-center gap-2 rounded-full bg-orange-200 px-5 py-2.5 text-sm font-bold text-stone-900 transition hover:bg-white">
            走進書庫
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6" /></svg>
          </a>
          <a href={`${BASE}stats/`} class="rounded-full border border-white/15 px-5 py-2.5 text-sm font-medium text-stone-200 transition hover:border-white/40 hover:bg-white/10">看看閱讀足跡</a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10">
        {statCards.map((stat) => (
          <div class="bg-stone-900/60 p-5 backdrop-blur-sm sm:p-6">
            <p class="font-serif text-3xl font-semibold tabular-nums text-white sm:text-4xl">
              {stat.value}<span class="ml-1.5 text-xs font-normal text-stone-400">{stat.unit}</span>
            </p>
            <p class="mt-2 text-xs tracking-wide text-stone-400">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {readingBooks.length > 0 && (
    <section class="mb-16">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow">On the nightstand</p>
          <h2 class="section-title mt-2">此刻正在讀</h2>
        </div>
        <a href={`${BASE}books/?status=reading`} class="hidden items-center gap-1 text-sm font-medium text-stone-500 transition hover:text-clay sm:flex">
          查看全部 <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {readingBooks.map((book) => <BookCard book={book} />)}
      </div>
    </section>
  )}

  {finishedBooks.length > 0 && (
    <section class="mb-16">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Recently finished</p>
          <h2 class="section-title mt-2">最近讀完</h2>
        </div>
        <a href={`${BASE}books/?status=finished`} class="flex items-center gap-1 text-sm font-medium text-stone-500 transition hover:text-clay">
          全部紀錄 <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {finishedBooks.slice(0, 4).map((book) => <BookCard book={book} />)}
      </div>
    </section>
  )}

  <section class="grid gap-5 lg:grid-cols-[1.1fr_0.9fr]">
    <div class="surface relative overflow-hidden rounded-[1.6rem] p-6 sm:p-8" data-book-picker>
      <div class="absolute -right-10 -top-12 size-40 rounded-full bg-orange-100/70" aria-hidden="true"></div>
      <div class="relative">
        <p class="eyebrow">Next read</p>
        <h2 class="mt-2 font-serif text-2xl font-semibold text-stone-900">下一本讀什麼？</h2>
        {firstPick ? (
          <>
            <div class="mt-7 border-l-2 border-orange-300 pl-5">
              <p class="font-serif text-2xl font-bold text-stone-900" data-pick-title>{firstPick.title}</p>
              <p class="mt-1 text-sm text-stone-500"><span data-pick-author>{firstPick.author}</span> · <span data-pick-tags>{firstPick.tags}</span></p>
            </div>
            <div class="mt-7 flex flex-wrap gap-3">
              <a href={firstPick.href} data-pick-link class="rounded-full bg-stone-900 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-clay">就讀這本</a>
              <button type="button" data-pick-again class="rounded-full border border-stone-300 bg-white px-5 py-2.5 text-sm font-medium text-stone-700 transition hover:border-orange-300 hover:text-clay">再抽一次</button>
            </div>
          </>
        ) : (
          <p class="mt-6 text-sm leading-7 text-stone-500">待讀清單還是空的。下次遇見想讀的書，先替未來的自己收進書架吧。</p>
        )}
      </div>
    </div>

    <div class="rounded-[1.6rem] bg-[#d9e0d4] p-6 sm:p-8">
      <p class="eyebrow !text-sage">Browse the shelf</p>
      <h2 class="mt-2 font-serif text-2xl font-semibold text-stone-900">從主題開始逛</h2>
      <div class="mt-6 flex flex-wrap gap-2.5">
        {popularTags.length > 0 ? popularTags.map(([tag, count]) => (
          <a href={`${BASE}tags/${encodeURIComponent(tag)}/`} class="rounded-full border border-white/60 bg-white/55 px-4 py-2 text-sm text-stone-700 transition hover:-translate-y-0.5 hover:bg-white">
            #{tag} <span class="ml-1 text-xs text-stone-400">{count}</span>
          </a>
        )) : <span class="text-sm text-stone-500">加入標籤後，就能從主題探索書架。</span>}
      </div>
    </div>
  </section>

  <script define:vars={{ pickOptions }}>
    const picker = document.querySelector('[data-book-picker]');
    const button = picker?.querySelector('[data-pick-again]');
    let previousIndex = 0;

    button?.addEventListener('click', () => {
      if (!pickOptions.length) return;
      let index = Math.floor(Math.random() * pickOptions.length);
      if (pickOptions.length > 1 && index === previousIndex) index = (index + 1) % pickOptions.length;
      previousIndex = index;
      const pick = pickOptions[index];
      picker.querySelector('[data-pick-title]').textContent = pick.title;
      picker.querySelector('[data-pick-author]').textContent = pick.author;
      picker.querySelector('[data-pick-tags]').textContent = pick.tags;
      picker.querySelector('[data-pick-link]').href = pick.href;
    });
  </script>
</Layout>

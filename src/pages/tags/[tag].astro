---
import Layout from '../../layouts/Layout.astro';
import BookCard from '../../components/BookCard.astro';
import { getCollection } from 'astro:content';
import { sortByStartedDesc } from '../../utils/books';

export async function getStaticPaths() {
  const all = await getCollection('books');
  const tags = [...new Set(all.flatMap((book) => book.data.tags))].sort((a, b) => a.localeCompare(b, 'zh-Hant'));
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const all = sortByStartedDesc(await getCollection('books'));
const books = all.filter((book) => book.data.tags.includes(tag));
const BASE = import.meta.env.BASE_URL;
---

<Layout title={`#${tag}`} description={`瀏覽標記為${tag}的閱讀紀錄。`}>
  <nav class="mb-8 flex items-center gap-2 text-sm text-stone-400" aria-label="麵包屑">
    <a href={`${BASE}books/`} class="transition hover:text-clay">書庫</a><span aria-hidden="true">/</span><span class="text-stone-600">#{tag}</span>
  </nav>

  <header class="mb-9 flex flex-col gap-4 border-b border-stone-200 pb-8 sm:flex-row sm:items-end sm:justify-between">
    <div><p class="eyebrow">Browse by topic</p><h1 class="page-title mt-3">#{tag}</h1></div>
    <p class="text-sm text-stone-500">這個主題收藏了 <strong class="font-semibold text-stone-800">{books.length}</strong> 本書</p>
  </header>

  <div class="grid gap-5 md:grid-cols-2">{books.map((book) => <BookCard book={book} />)}</div>

  <a href={`${BASE}books/`} class="mt-10 inline-flex items-center gap-2 text-sm font-medium text-stone-500 transition hover:text-clay"><span aria-hidden="true">←</span> 回到完整書庫</a>
</Layout>

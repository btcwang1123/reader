---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = '', description = '我讀過的書,以及寫下的心得與摘錄' } = Astro.props;

const SITE_TITLE = '閱讀書架';
const BASE = import.meta.env.BASE_URL;
const nav = [
  { href: `${BASE}`, label: '首頁' },
  { href: `${BASE}books/`, label: '書庫' },
  { href: `${BASE}stats/`, label: '統計' },
  { href: `${BASE}export/`, label: '匯出' },
  { href: `${BASE}about/`, label: '關於' }
];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <title>{title ? `${title} · ${SITE_TITLE}` : SITE_TITLE}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen">
    <header class="border-b border-stone-200/80 bg-gradient-to-r from-amber-50 via-paper to-amber-50">
      <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-3 px-6 py-5">
        <a href={BASE} class="group flex items-center gap-2.5">
          <span class="text-2xl transition-transform group-hover:-rotate-6" aria-hidden="true">📚</span>
          <span class="font-serif text-2xl tracking-wide text-stone-800">閱讀書架</span>
        </a>
        <nav class="flex flex-wrap items-center gap-1 text-sm">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-full px-3.5 py-1.5 text-stone-600 transition hover:bg-amber-100 hover:text-amber-800',
                Astro.url.pathname === item.href && 'bg-amber-100 font-medium text-amber-800'
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-4xl px-6 py-10">
      <slot />
    </main>

    <footer class="mt-10 border-t border-stone-200/80 bg-gradient-to-r from-amber-50 via-paper to-amber-50">
      <div class="mx-auto max-w-4xl px-6 py-8 text-center">
        <p class="font-serif text-lg text-stone-700">{SITE_TITLE}</p>
        <p class="mt-1 text-sm text-stone-400">以 Astro 建置 · 內容保存於 Markdown</p>
      </div>
    </footer>
  </body>
</html>

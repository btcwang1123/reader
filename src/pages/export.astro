---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { finished } from '../utils/books';

const all = await getCollection('books');
const BASE = import.meta.env.BASE_URL;
---

<Layout title="匯出">
  <h1 class="mb-4 text-2xl font-bold">📦 匯出資料</h1>
  <p class="mb-2 text-stone-600">
    所有書籍資料以 JSON 格式提供下載,方便備份或遷移到其他平台。
  </p>
  <p class="mb-6 text-sm text-stone-500">
    目前共收錄 {all.length} 本書(其中 {finished(all).length} 本已讀)。
  </p>

  <a
    href={`${BASE}export/books.json`}
    download="books.json"
    class="inline-block rounded-lg bg-amber-600 px-5 py-3 font-semibold text-white transition hover:bg-amber-700"
  >
    ⬇️ 下載 books.json
  </a>

  <p class="mt-6 text-sm text-stone-500">
    每本書對應的 Markdown 檔也直接保存在 <code>src/content/books/</code>
    目錄中,本身就是最完整的備份。
  </p>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import BookCard from '../../components/BookCard.astro';
import Stars from '../../components/Stars.astro';
import { getCollection } from 'astro:content';
import { firstQuote } from '../../utils/books';

export async function getStaticPaths() {
  const all = await getCollection('books');
  const years = [...new Set(all.flatMap((book) => book.data.finishedAt ? [book.data.finishedAt.getFullYear()] : []))].sort((a, b) => b - a);
  return years.map((year) => ({ params: { year: String(year) } }));
}

const all = await getCollection('books');
const year = Number(Astro.params.year);
const books = all
  .filter((book) => book.data.status === 'finished' && book.data.finishedAt?.getFullYear() === year)
  .sort((a, b) => (a.data.finishedAt?.getTime() ?? 0) - (b.data.finishedAt?.getTime() ?? 0));
const BASE = import.meta.env.BASE_URL;
const pages = books.reduce((sum, book) => sum + (book.data.progress?.totalPages ?? 0), 0);
const minutes = books.reduce((sum, book) => sum + (book.data.readingMinutes ?? 0), 0);
const rated = books.filter((book) => book.data.rating !== undefined);
const average = rated.length ? rated.reduce((sum, book) => sum + (book.data.rating ?? 0), 0) / rated.length : null;
const tags = new Map<string, number>();
for (const book of books) for (const tag of book.data.tags) tags.set(tag, (tags.get(tag) ?? 0) + 1);
const topTags = [...tags.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6);
const months = Array.from({ length: 12 }, (_, i) => ({
  label: `${i + 1}月`, count: books.filter((book) => book.data.finishedAt?.getMonth() === i).length
}));
const maxMonth = Math.max(...months.map(({ count }) => count), 1);
const highestRated = [...rated].sort((a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0))[0];
const quotes = [...books].reverse().map((book) => ({ book, quote: firstQuote(book.body ?? '') })).filter((item) => item.quote).slice(0, 3);
---

<Layout title={`${year} 年度閱讀回顧`} description={`${year} 年度閱讀回顧：讀完 ${books.length} 本書，回望這一年的閱讀足跡。`}>
  <nav class="mb-8 flex items-center gap-2 text-sm text-stone-400" aria-label="麵包屑">
    <a href={`${BASE}stats/`} class="transition hover:text-clay">閱讀足跡</a><span aria-hidden="true">/</span><span class="text-stone-600">{year} 年度回顧</span>
  </nav>
  <header class="relative mb-10 overflow-hidden rounded-[2rem] bg-stone-900 px-6 py-10 text-white sm:px-10 sm:py-14">
    <div class="absolute -right-8 -top-16 size-64 rounded-full border border-white/10" aria-hidden="true"></div>
    <p class="relative text-xs font-bold uppercase tracking-[0.24em] text-orange-300">A year between the pages</p>
    <h1 class="relative mt-4 font-serif text-4xl font-semibold sm:text-6xl">{year}，讀過的日子</h1>
    <p class="relative mt-4 max-w-xl text-sm leading-7 text-stone-300">每一本讀完的書，都是這一年留下的一道折痕。這是你的年度閱讀切片。</p>
    <p class="relative mt-8 font-serif text-2xl text-orange-100">{books.length} <span class="text-base text-stone-300">本書，{rated.length ? `平均 ${average!.toFixed(1)} 顆星` : '留下了閱讀的痕跡'}</span></p>
  </header>

  <section class="mb-10 grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="年度摘要">
    {[
      { label: '讀完本數', value: String(books.length), unit: '本' },
      { label: '累積頁數', value: pages.toLocaleString(), unit: '頁' },
      { label: '閱讀時數', value: (minutes / 60).toFixed(1), unit: '小時' },
      { label: '平均評分', value: average?.toFixed(1) ?? '—', unit: average ? '/ 5' : '' }
    ].map((item) => (
      <div class="surface rounded-[1.4rem] p-5 sm:p-6">
        <p class="font-serif text-3xl font-semibold tabular-nums text-stone-900 sm:text-4xl">{item.value}<span class="ml-1.5 text-xs font-normal text-stone-400">{item.unit}</span></p>
        <p class="mt-2 text-xs tracking-wide text-stone-500">{item.label}</p>
      </div>
    ))}
  </section>

  <section class="mb-10 grid gap-5 lg:grid-cols-[1.2fr_0.8fr]">
    <div class="surface rounded-[1.6rem] p-6 sm:p-8">
      <p class="eyebrow">Monthly rhythm</p><h2 class="mt-2 font-serif text-xl font-semibold text-stone-900">每月讀完</h2>
      <div class="mt-7 grid grid-cols-6 gap-3 sm:grid-cols-12">
        {months.map((month) => (
          <div class="flex flex-col items-center gap-2" title={`${month.label}：${month.count} 本`}>
            <div class="flex h-28 w-full items-end overflow-hidden rounded-lg bg-stone-100">
              <div class:list={['w-full rounded-lg', month.count ? 'bg-sage' : 'bg-stone-200/60']} style={`height:${month.count ? Math.max((month.count / maxMonth) * 100, 10) : 5}%`}></div>
            </div>
            <span class="text-[0.65rem] text-stone-500">{month.label.replace('月', '')}</span>
            <span class="text-[0.6rem] tabular-nums text-stone-400">{month.count}</span>
          </div>
        ))}
      </div>
    </div>
    <aside class="rounded-[1.6rem] bg-[#d9e0d4] p-6 sm:p-8">
      <p class="eyebrow !text-sage">Topics of the year</p><h2 class="mt-2 font-serif text-xl font-semibold text-stone-900">這一年讀了什麼</h2>
      {topTags.length ? <ol class="mt-6 space-y-3">{topTags.map(([tag, count], i) => <li class="flex items-center gap-3"><span class="grid size-7 place-items-center rounded-full bg-white/70 text-xs text-stone-500">{i + 1}</span><span class="flex-1 text-sm text-stone-700">#{tag}</span><strong class="text-xs text-stone-500">{count} 本</strong></li>)}</ol> : <p class="mt-5 text-sm text-stone-500">這年還沒有標籤資料。</p>}
      {highestRated && <div class="mt-7 border-t border-white/60 pt-5"><p class="text-xs text-stone-500">年度最愛</p><a href={`${BASE}books/${highestRated.id}/`} class="mt-2 block font-serif text-lg font-semibold text-stone-900 hover:text-clay">{highestRated.data.title}</a><div class="mt-2"><Stars rating={highestRated.data.rating!} showValue /></div></div>}
    </aside>
  </section>

  {quotes.length > 0 && <section class="mb-10">
    <p class="eyebrow">Words to remember</p><h2 class="section-title mt-2 mb-5">這一年留下的句子</h2>
    <div class="grid gap-4 md:grid-cols-3">{quotes.map(({ book, quote }) => <a href={`${BASE}books/${book.id}/`} class="surface card-lift rounded-[1.3rem] p-5"><span class="font-serif text-4xl leading-none text-orange-300" aria-hidden="true">“</span><blockquote class="mt-2 font-serif leading-7 text-stone-700">「{quote}」</blockquote><p class="mt-4 border-t border-stone-100 pt-3 text-sm font-medium text-stone-600">《{book.data.title}》</p></a>)}</div>
  </section>}

  {books.length > 0 && <section>
    <p class="eyebrow">The books</p><h2 class="section-title mt-2 mb-5">讀過的書</h2>
    <div class="grid gap-5 md:grid-cols-2">{books.map((book) => <BookCard book={book} />)}</div>
  </section>}
</Layout>
